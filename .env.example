# =============================================================================
# Unified RAG Environment Configuration Template
# =============================================================================

# Nine Router Endpoint (Local LLM & Embedding Proxy)
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_API_KEY=your_nine_router_key_here
LLM_MODEL=gemini-cli

# OmniRoute Endpoint (Local Gateway on Port 20130)
OMNIROUTE_BASE_URL=http://localhost:20130/v1
OMNIROUTE_API_KEY=your_omniroute_key_here
OMNIROUTE_MODEL=deepseek-web2api

# JEV / TypeSafe System One (Nine Router Gateway)
JEV_BASE_URL=http://localhost:20128/v1/systemone
JEV_LOCAL_API_KEY=your_local_jev_key_here
JEV_MODEL=oc/jev-1.13-free

# Legacy TypeSafe.ai Cloud Keys (Fallback)
JEV_API_KEY=your_jev_api_key_here
SYSTEM_ONE_API_KEY=your_system_one_api_key_here

# Embedding Model (BGE-M3 on Nine Router)
EMBEDDING_MODEL_NAME=un/gpustack/bge-m3-GGUF
EMBEDDING_MODEL_PATH=~/.cache/huggingface/hub/models--BAAI--bge-m3/snapshots/...

# Langfuse Observability (Cloud: https://cloud.langfuse.com or local Docker: http://localhost:3000)
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=your_public_key_here
LANGFUSE_SECRET_KEY=your_secret_key_here
LANGFUSE_ENABLED=true

# Vector Database (Qdrant: "embedded" for SQLite-like zero-docker file storage, or "server" for Docker)
QDRANT_MODE=embedded
QDRANT_PATH=data_index/qdrant_db
QDRANT_COLLECTION=unified_rag_chunks
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# Knowledge Graph (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Relational Catalog & Text-to-SQL (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=unified_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/unified_rag

# Caching (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# App Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
