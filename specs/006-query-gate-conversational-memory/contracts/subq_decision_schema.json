{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SubQSystemOneRequest",
  "type": "object",
  "required": ["model", "state", "questions"],
  "properties": {
    "model": {
      "type": "string",
      "enum": ["subq-snap-preview"]
    },
    "state": {
      "type": "object",
      "required": ["current_query"],
      "properties": {
        "current_query": { "type": "string" },
        "instructions": { "type": "string" },
        "turns_metadata": { "type": "array" }
      }
    },
    "questions": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "additionalProperties": {
        "type": "object",
        "required": ["type", "instructions", "criteria"],
        "properties": {
          "type": { "type": "string", "enum": ["choice", "noul", "score"] },
          "instructions": { "type": "string" },
          "criteria": {
            "type": "object",
            "required": [
              "not_needed_not_relevant",
              "not_needed_relevant",
              "needed_not_relevant",
              "needed_relevant"
            ],
            "properties": {
              "not_needed_not_relevant": { "type": ["string", "null"] },
              "not_needed_relevant": { "type": ["string", "null"] },
              "needed_not_relevant": { "type": ["string", "null"] },
              "needed_relevant": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
